{
  "name": "nupper-kun-web",
  "version": "0.0.2",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check build-only",
    "build:pages": "GITHUB_PAGES=true run-p type-check build-only",
    "preview": "vite preview",
    "preview:pages": "GITHUB_PAGES=true yarn build:pages && yarn preview",
    "test:unit": "vitest --environment jsdom --root src/",
    "test:e2e": "start-server-and-test preview :4173 'cypress run --e2e'",
    "test:e2e:dev": "start-server-and-test 'vite dev --port 4173' :4173 'cypress open --e2e'",
    "build-only": "vite build",
    "type-check": "tsc --noEmit -p tsconfig.app.json",
    "lint": "eslint . --ext .js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-path .gitignore"
  },
  "dependencies": {
    "@primer/css": "^20.5.1",
    "axios": "^1.20.0",
    "date-fns": "^2.29.3",
    "decimal.js": "^10.6.0",
    "react": "^19.3.0",
    "react-datepicker": "^9.1.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.3",
    "vite-plugin-rewrite-all": "^1.0.2",
    "web3": "^4.16.0"
  },
  "devDependencies": {
    "@rushstack/eslint-patch": "^1.16.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/decimal.js": "^7.4.3",
    "@types/jsdom": "^20.0.0",
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-datepicker": "^7.0.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@vitejs/plugin-react": "^6.1.1",
    "cypress": "^16.0.0",
    "eslint": "^8.22.0",
    "eslint-plugin-cypress": "^2.12.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^20.0.1",
    "npm-run-all": "^4.1.5",
    "prettier": "^2.7.1",
    "sass": "^1.104.0",
    "start-server-and-test": "^1.14.0",
    "typescript": "^5",
    "vite": "^8",
    "vitest": "^5.0.0"
  }
}
